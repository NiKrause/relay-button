[Unit]
Description=Ephemeral GitHub Actions runner (one job, then forget and power off)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/github-runner-start
ExecStopPost=/usr/local/sbin/github-runner-finish
Restart=no
# Room for github-runner-finish: three bounded FORGET attempts, then poweroff.
TimeoutStopSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
